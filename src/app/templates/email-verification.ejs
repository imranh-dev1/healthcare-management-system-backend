<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email - Healthcare System</title>
</head>

<body style="
    margin:0;
    padding:0;
    background-color:#f4f7fb;
    font-family:Arial, Helvetica, sans-serif;
">

    <div style="padding:40px 20px;">

        <div style="
            max-width:600px;
            margin:0 auto;
            background:#ffffff;
            border-radius:12px;
            overflow:hidden;
            box-shadow:0 4px 15px rgba(0,0,0,0.08);
        ">

            <!-- Header -->
            <div style="
                padding:28px 32px;
                background:#0f766e;
                text-align:center;
            ">
                <h1 style="
                    margin:0;
                    color:#ffffff;
                    font-size:24px;
                    font-weight:700;
                ">
                    Healthcare System
                </h1>
            </div>

            <!-- Content -->
            <div style="padding:35px 32px;">

                <h2 style="
                    margin:0 0 16px;
                    color:#1f2937;
                    font-size:22px;
                    font-weight:600;
                ">
                    Verify Your Email Address
                </h2>

                <p style="
                    margin:0 0 20px;
                    color:#4b5563;
                    font-size:15px;
                    line-height:1.6;
                ">
                    Welcome to Healthcare System!
                    Please use the verification code below to verify your
                    email address and complete your account registration.
                </p>

                <!-- OTP -->
                <div style="
                    margin:28px 0;
                    padding:22px;
                    background:#f0fdfa;
                    border:1px solid #99f6e4;
                    border-radius:8px;
                    text-align:center;
                ">

                    <p style="
                        margin:0 0 10px;
                        color:#64748b;
                        font-size:13px;
                    ">
                        Your verification code
                    </p>

                    <div style="
                        font-size:32px;
                        font-weight:700;
                        letter-spacing:8px;
                        color:#0f766e;
                    ">
                        <%= otpValue %>
                    </div>

                </div>

                <!-- Expiration -->
                <% if (typeof password !== "undefined" && password) { %>
                <div style="
                    margin:0 0 20px;
                    padding:16px;
                    background:#f0f9ff;
                    border:1px solid #bae6fd;
                    border-radius:8px;
                ">
                    <p style="margin:0 0 6px; color:#475569; font-size:13px;">
                        Your temporary login password:
                    </p>
                    <p style="
                        margin:0;
                        font-size:20px;
                        font-weight:700;
                        color:#0369a1;
                        word-break:break-all;
                    ">
                        <%= password %>
                    </p>
                    <p style="margin:8px 0 0; color:#64748b; font-size:13px; line-height:1.5;">
                        Use this password and your email to log in, then verify your email with the
                        code above. You can change your password after logging in.
                    </p>
                </div>
                <% } %>

                <!-- Expiration -->
                <p style="
                    margin:0 0 12px;
                    color:#4b5563;
                    font-size:14px;
                    line-height:1.6;
                ">
                    This verification code will expire in
                    <strong>5 minutes</strong>.
                </p>

                <p style="
                    margin:0;
                    color:#4b5563;
                    font-size:14px;
                    line-height:1.6;
                ">
                    Please do not share this code with anyone.
                    Healthcare System will never ask you for your verification code.
                </p>

                <!-- Security Notice -->
                <div style="
                    margin-top:24px;
                    padding:14px 16px;
                    background:#fff7ed;
                    border-left:4px solid #f97316;
                    border-radius:4px;
                ">
                    <p style="
                        margin:0;
                        color:#9a3412;
                        font-size:13px;
                        line-height:1.5;
                    ">
                        <strong>Security notice:</strong>
                        If you did not create a Healthcare System account,
                        you can safely ignore this email.
                    </p>
                </div>

                <!-- Closing -->
                <p style="
                    margin:30px 0 0;
                    color:#6b7280;
                    font-size:14px;
                    line-height:1.6;
                ">
                    Thank you for choosing Healthcare System.<br><br>

                    Regards,<br>

                    <strong style="color:#374151;">
                        Healthcare System Team
                    </strong>
                </p>

            </div>

            <!-- Footer -->
            <div style="
                padding:20px 32px;
                background:#f8fafc;
                text-align:center;
            ">

                <p style="
                    margin:0;
                    color:#94a3b8;
                    font-size:12px;
                ">
                    © <%= year %> Healthcare System. All rights reserved.
                </p>

            </div>

        </div>

    </div>

</body>
</html>