				{
					"name": "Verify Email + Complete Registration",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"otp\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register-email-verify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register-email-verify"
							]
						},
						"description": "Verify the OTP from the registration email. On success returns accessToken + refreshToken and sets the `accessToken` collection variable for subsequent requests."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data && json.data.accessToken) {",
									"  pm.collectionVariables.set('accessToken', json.data.accessToken);",
									"  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
									"}",
									"pm.environment.set('patientId', json?.data?.patient?.id || '');"
								]
							}
						}
					],
					"response": []
				},
