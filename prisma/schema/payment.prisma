model Payment {
    id                    String        @id @default(uuid())
    amount                Decimal       @db.Decimal(10, 2)
    curency               String        @default("BDT")
    paymentGateway        String        @default("bkash")
    merchentInvoiceNumber String        @unique
    bkashPaymentId        String?       @unique
    bkashTrxId            String?
    payerReferemce        String?
    paidAt                String?
    getewayResponse       Json?
    status                PaymentStatus @default(UNPAID)
    refundTrxId           String?
    refundAmount          Decimal       @db.Decimal(10, 2)
    refundReason          String?
    refundedAt            String?
    appointmentId         String        @unique
    appointment           Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    createdAt             DateTime      @default(now())
    updatedAt             DateTime      @updatedAt

    @@map("payments")
}
